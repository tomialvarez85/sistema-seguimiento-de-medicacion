# Variables opcionales del backend. Todas tienen un valor por defecto: no hace falta crear un .env
# para usar la aplicación. Si quiere cambiarlas, defínalas en la terminal antes de iniciar.

# Puerto de la API (el frontend la consulta a través del proxy de Vite)
API_PORT=3001

# Archivo de la base SQLite (ruta relativa a la carpeta server/ o absoluta)
DB_PATH=../data/pastillero.sqlite

# Orígenes desde donde se aceptan cambios (protección contra solicitudes de otros sitios)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Días que dura una sesión iniciada
SESSION_DAYS=7

# Horas de validez de un código de vinculación
LINK_CODE_HOURS=48

# Poner en true solo si se sirve con HTTPS
COOKIE_SECURE=false

# Frontend: dirección de la API para el proxy de Vite
API_URL=http://127.0.0.1:3001
